# Copia este archivo a .env.local y rellena los valores. .env.local no se sube a git.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública: "Publishable key" (sb_publishable_...) o la antigua "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo en local, para crear el usuario de prueba. NUNCA en Vercel ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Usuario de prueba ---
NEXT_PUBLIC_DEMO_EMAIL=demo@agentteam.dev
DEMO_PASSWORD=

# --- Modelo de IA para los agentes (Fase 2) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
